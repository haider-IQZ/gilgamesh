// Gilgamesh fastfetch config: shown when a terminal opens (fish/greeting.fish) and by a plain
// `fastfetch` (installed as /etc/fastfetch/config.jsonc; your ~/.config/fastfetch/config.jsonc
// replaces it). Colors are the terminal's palette colors, so they follow the theme: the bar
// sets the terminal palette on every theme switch (quickshell/Theme.qml), green = the
// theme's green.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/gilgamesh/fastfetch/logo.txt",
        "color": { "1": "green" },
        "padding": { "right": 3 }
    },
    "display": {
        "color": { "keys": "green", "title": "green" }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell" },
        { "type": "wm", "key": "WM" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memory" },
        "break",
        "colors"
    ]
}
