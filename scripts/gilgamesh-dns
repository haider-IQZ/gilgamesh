#!/usr/bin/env bash
#
# gilgamesh-dns: show or switch the DNS provider for the whole system.
#
#   gilgamesh-dns              print the current provider
#   gilgamesh-dns <provider>   DHCP | Cloudflare | Google | OpenDNS | Custom
#
# Based on Omarchy's omarchy-dns. Every app resolves through systemd-resolved, so the
# servers are set everywhere resolved can get them from:
#   - every wired / Wi-Fi NetworkManager connection: "ignore the router's DNS, use these",
#     with DNS-over-TLS where the provider supports it (Cloudflare, Google)
#   - on Gilgamesh (normal /etc) also: NetworkManager's global DNS and resolved.conf
#     (needs root: a sudoers rule allows the presets without a password)
#   - on NixOS /etc is read-only and generated by Nix, so only the connection part runs.
#     No root needed if you're in the `networkmanager` group.

set -euo pipefail

NM_GLOBAL_CONF=/etc/NetworkManager/conf.d/20-gilgamesh-dns.conf
RESOLVED_CONF=/etc/systemd/resolved.conf
INSTALLED_PATH=/usr/bin/gilgamesh-dns   # what the sudoers rule names (Gilgamesh)

# provider -> IPv4, IPv6, DNS-over-TLS server name (empty = no DoT)
declare -A V4=(
    [Cloudflare]="1.1.1.1 1.0.0.1"
    [Google]="8.8.8.8 8.8.4.4"
    [OpenDNS]="208.67.222.222 208.67.220.220"
)
declare -A V6=(
    [Cloudflare]="2606:4700:4700::1111 2606:4700:4700::1001"
    [Google]="2001:4860:4860::8888 2001:4860:4860::8844"
    [OpenDNS]="2620:119:35::35 2620:119:53::53"
)
declare -A SNI=(
    [Cloudflare]="cloudflare-dns.com"
    [Google]="dns.google"
)

is_nixos() { [[ -e /etc/NIXOS ]]; }

usage() { echo "usage: gilgamesh-dns [DHCP|Cloudflare|Google|OpenDNS|Custom]" >&2; exit 1; }

# wired + Wi-Fi connection profiles (UUIDs)
profiles() {
    nmcli -t -f UUID,TYPE connection show | awk -F: '$2 == "802-3-ethernet" || $2 == "802-11-wireless" { print $1 }'
}

# "1.1.1.1 1.0.0.1" + "cloudflare-dns.com" -> "1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com"
with_sni() {
    local ips=$1 sni=$2 out="" ip
    for ip in $ips; do out+="${out:+ }$ip${sni:+#$sni}"; done
    printf '%s' "$out"
}

current() {
    local uuid ignore dns first name
    uuid=$(nmcli -t -f UUID,TYPE,DEVICE connection show --active |
        awk -F: '($2 == "802-3-ethernet" || $2 == "802-11-wireless") && $3 != "" { print $1; exit }')
    [[ -n $uuid ]] || { echo "DHCP"; return; }

    ignore=$(nmcli -g ipv4.ignore-auto-dns connection show "$uuid")
    dns=$(nmcli -g ipv4.dns connection show "$uuid")
    if [[ $ignore != yes || -z $dns ]]; then echo "DHCP"; return; fi

    first=${dns%%[ ,]*}; first=${first%%#*}
    for name in "${!V4[@]}"; do
        [[ " ${V4[$name]} " == *" $first "* ]] && { echo "$name"; return; }
    done
    echo "Custom"
}

# set DNS on every wired / Wi-Fi profile, then re-apply the active ones
apply_connections() {
    local v4=$1 v6=$2 dot=$3 ignore=$4 uuid dev type state
    while read -r uuid; do
        [[ -n $uuid ]] || continue
        nmcli connection modify "$uuid" \
            ipv4.ignore-auto-dns "$ignore" ipv4.dns "$v4" \
            ipv6.ignore-auto-dns "$ignore" ipv6.dns "$v6" \
            connection.dns-over-tls "$dot"
    done < <(profiles)

    while IFS=: read -r dev type state; do
        [[ $state == connected && ( $type == ethernet || $type == wifi ) ]] || continue
        nmcli device reapply "$dev" >/dev/null 2>&1 || true
    done < <(nmcli -t -f DEVICE,TYPE,STATE device status)
}

# Gilgamesh only (writable /etc): NetworkManager global DNS + resolved.conf, like Omarchy
apply_etc() {
    local servers=$1 dot=$2   # servers = space separated, with #sni where used
    if [[ -n $servers ]]; then
        install -d -m 0755 "$(dirname "$NM_GLOBAL_CONF")"
        printf '# Managed by gilgamesh-dns. "gilgamesh-dns DHCP" removes it.\n[global-dns]\n\n[global-dns-domain-*]\nservers=%s\n' \
            "${servers// /,}" >"$NM_GLOBAL_CONF"
        printf '[Resolve]\nDNS=%s\nFallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net\nDNSOverTLS=%s\n' \
            "$servers" "$dot" >"$RESOLVED_CONF"
    else
        rm -f "$NM_GLOBAL_CONF"
        printf '[Resolve]\nDNSOverTLS=no\n' >"$RESOLVED_CONF"
    fi
    nmcli general reload conf >/dev/null 2>&1 || systemctl reload NetworkManager.service || true
    systemctl reload systemd-resolved.service 2>/dev/null || systemctl restart systemd-resolved.service
    nmcli general reload dns-full >/dev/null 2>&1 || true
}

# Gilgamesh: re-run as root (passwordless for presets via sudoers, else sudo/pkexec prompt)
require_root() {
    (( EUID == 0 )) && { export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin; return; }
    if [[ -t 0 ]] || sudo -n -l "$INSTALLED_PATH" "$@" >/dev/null 2>&1; then
        exec sudo "$INSTALLED_PATH" "$@"
    else
        exec pkexec "$INSTALLED_PATH" "$@"
    fi
}

(( $# == 0 )) && { current; exit 0; }
(( $# == 1 )) || usage
provider=$1
case $provider in DHCP | Cloudflare | Google | OpenDNS | Custom) ;; *) usage ;; esac

is_nixos || require_root "$provider"

v4="" v6="" dot="-1" ignore="no" sni=""
case $provider in
DHCP) ;;
Custom)
    read -r -p "DNS servers (space separated, e.g. 9.9.9.9 149.112.112.112): " input
    for s in ${input//,/ }; do
        if [[ $s =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then v4+="${v4:+ }$s"
        elif [[ $s =~ ^[0-9a-fA-F:]+$ && $s == *:* ]]; then v6+="${v6:+ }$s"
        else echo "not an IP address: $s" >&2; exit 1; fi
    done
    [[ -n $v4$v6 ]] || { echo "no servers given" >&2; exit 1; }
    ignore="yes"
    ;;
*)
    sni=${SNI[$provider]:-}
    v4=$(with_sni "${V4[$provider]}" "$sni")
    v6=$(with_sni "${V6[$provider]}" "$sni")
    ignore="yes"
    [[ -n $sni ]] && dot="opportunistic"
    ;;
esac

apply_connections "$v4" "$v6" "$dot" "$ignore"
if ! is_nixos; then
    etc_dot=no; [[ $dot == opportunistic ]] && etc_dot=opportunistic
    apply_etc "$(echo $v4 $v6)" "$etc_dot"
fi
echo "DNS: $provider"
